algoritmo "Salario"

var
    nome: caractere
    salario: real

inicio
    Escreva ("Digite o nome do funcionario: ")
    leia(nome)
    Escreva ("Qual o salário do funcionario: ")
    leia(salario)

    Escreval ("O funcionario ", nome , " tem um salário de R$: ", salario, " em Junho")

fimalgoritmo