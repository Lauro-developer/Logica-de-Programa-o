algoritmo "Dobro_e_terca_parte"

var 
    numero,dobro,terc_part: real 

inicio
    Escreva ("Digite um número: ")
    leia(numero)

    dobro <- numero * 2

    terc_part <- numero / 3

    Escreval ("O dobro de ", numero , " é ", dobro)
    Escreval ("A terca parte de ", numero , " é ", terc_part)

fimalgoritmo